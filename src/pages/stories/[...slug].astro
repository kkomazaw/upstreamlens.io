---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => {
    return data.draft !== true;
  });

  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();
---

<BaseLayout title={`${story.data.title} | Upstream Lens`} description={story.data.description}>
  <article class="story">
    <header class="story-header">
      <h1>{story.data.title}</h1>
      <div class="story-meta">
        <time datetime={story.data.pubDate.toISOString()}>
          {story.data.pubDate.toLocaleDateString('ja-JP', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        <span class="category">{story.data.category}</span>
      </div>
      {story.data.tags && story.data.tags.length > 0 && (
        <div class="tags">
          {story.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="story-content">
      <Content />
    </div>

    <footer class="story-footer">
      <nav class="story-nav">
        <a href="/stories" class="back-link">← Storiesに戻る</a>
      </nav>
    </footer>
  </article>
</BaseLayout>

<style>
  .story {
    max-width: 100%;
  }

  .story-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-color);
  }

  .story-header h1 {
    margin: 0 0 1rem 0;
  }

  .story-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .category {
    background-color: var(--code-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    font-weight: 600;
    color: var(--text-color);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background-color: var(--border-color);
    color: var(--text-color);
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    font-size: 0.875rem;
  }

  .story-content {
    margin: 3rem 0;
    line-height: 1.8;
  }

  .story-content :global(h2) {
    margin-top: 3rem;
  }

  .story-content :global(h3) {
    margin-top: 2rem;
  }

  .story-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 2rem 0;
  }

  .story-content :global(blockquote) {
    border-left: 4px solid var(--accent-color);
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .story-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .story-nav {
    text-align: center;
  }

  .back-link {
    color: var(--link-color);
    text-decoration: none;
    font-weight: 600;
  }

  .back-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .story-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .story-header h1 {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .story-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .story-content {
      margin: 2rem 0;
    }

    .story-content :global(h2) {
      margin-top: 2rem;
    }

    .story-content :global(h3) {
      margin-top: 1.5rem;
    }

    .story-content :global(blockquote) {
      padding-left: 1rem;
      margin: 1.5rem 0;
      font-size: 0.95rem;
    }

    .story-content :global(pre) {
      margin: 1.5rem -1.25rem;
      border-radius: 0;
      font-size: 0.875rem;
    }

    .story-footer {
      margin-top: 3rem;
    }

    .tags {
      gap: 0.375rem;
    }

    .tag {
      font-size: 0.8125rem;
      padding: 0.2rem 0.625rem;
    }
  }

  @media (max-width: 480px) {
    .story-header h1 {
      font-size: 1.5rem;
    }

    .story-content :global(pre) {
      font-size: 0.8125rem;
    }
  }
</style>
