---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort((a, b) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const postsByCategory = sortedPosts.reduce((acc, post) => {
  const category = post.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(post);
  return acc;
}, {} as Record<string, typeof sortedPosts>);

const categories = ['Philosophy', 'Notes', 'Analysis', 'Curation', 'Meta'] as const;
---

<BaseLayout title="Posts | Upstream Lens">
  <h1>Posts</h1>

  {sortedPosts.length === 0 ? (
    <section class="empty-state">
      <p>記事はまだ公開されていません。</p>
      <p>準備が整い次第、順次公開予定です。</p>
    </section>
  ) : (
    <>
      <section class="filter-section">
        <h2>4層で絞り込む</h2>
        <div class="filter-buttons">
          <button class="filter-btn active" data-layer="all">全て</button>
          <button class="filter-btn" data-layer="trends">📊 Trends</button>
          <button class="filter-btn" data-layer="discourse">💬 Discourse</button>
          <button class="filter-btn" data-layer="implementation">⚙️ Implementation</button>
          <button class="filter-btn" data-layer="impact">🔄 Impact</button>
        </div>
      </section>

      <section class="all-posts">
        <h2>最新記事</h2>
        <ul class="post-list">
          {sortedPosts.map(post => (
            <li class="post-item" data-layers={post.data.layers?.join(',') || ''}>
              <article class="post-preview">
                <h3>
                  <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                </h3>
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('ja-JP', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                  <span class="category">{post.data.category}</span>
                  {post.data.layers && post.data.layers.length > 0 && (
                    <span class="layers">
                      {post.data.layers.map(layer => (
                        <span class={`layer-tag ${layer}`}>
                          {layer === 'trends' && '📊'}
                          {layer === 'discourse' && '💬'}
                          {layer === 'implementation' && '⚙️'}
                          {layer === 'impact' && '🔄'}
                        </span>
                      ))}
                    </span>
                  )}
                </div>
                <p class="description">{post.data.description}</p>
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="by-category">
        <h2>カテゴリ別</h2>
        {categories.map(category => {
          const posts = postsByCategory[category];
          if (!posts || posts.length === 0) return null;

          return (
            <div class="category-section">
              <h3>{category}</h3>
              <ul class="post-list">
                {posts.map(post => (
                  <li>
                    <a href={`/posts/${post.slug}`}>{post.data.title}</a>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('ja-JP', {
                        year: 'numeric',
                        month: 'numeric',
                        day: 'numeric'
                      })}
                    </time>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </section>
    </>
  )}
</BaseLayout>

<style>
  .empty-state {
    text-align: center;
    padding: 3rem 0;
    color: var(--text-secondary);
  }

  .all-posts,
  .by-category {
    margin: 3rem 0;
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-preview {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .post-preview:last-child {
    border-bottom: none;
  }

  .post-preview h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }

  .post-preview h3 a {
    color: var(--heading-color);
    text-decoration: none;
  }

  .post-preview h3 a:hover {
    color: var(--accent-color);
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .category {
    background-color: var(--code-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    font-weight: 600;
  }

  .description {
    color: var(--text-color);
    margin: 0;
  }

  .category-section {
    margin: 2rem 0;
  }

  .category-section h3 {
    color: var(--accent-color);
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .category-section .post-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .category-section .post-list li:last-child {
    border-bottom: none;
  }

  .category-section .post-list a {
    flex: 1;
  }

  .category-section .post-list time {
    font-size: 0.875rem;
    color: var(--text-secondary);
    white-space: nowrap;
    margin-left: 1rem;
  }

  @media (max-width: 768px) {
    .all-posts,
    .by-category {
      margin: 2rem 0;
    }

    .post-preview {
      padding: 1.25rem 0;
    }

    .post-preview h3 {
      font-size: 1.25rem;
    }

    .post-meta {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .category-section .post-list li {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 1rem 0;
    }

    .category-section .post-list time {
      margin-left: 0;
      font-size: 0.8125rem;
    }

    .category-section .post-list a {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .post-preview h3 {
      font-size: 1.125rem;
    }

    .description {
      font-size: 0.9rem;
    }
  }

  /* Filter Section */
  .filter-section {
    margin: 2rem 0 3rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.03) 0%, rgba(118, 75, 162, 0.03) 100%);
    border-radius: 12px;
  }

  .filter-section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    border-bottom: none;
  }

  .filter-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.625rem 1.25rem;
    border: 2px solid var(--border-color);
    background: white;
    border-radius: 24px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-color);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    border-color: #667eea;
    color: #667eea;
    transform: translateY(-2px);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-color: transparent;
  }

  /* Layer Tags */
  .layers {
    display: inline-flex;
    gap: 0.375rem;
    margin-left: 0.5rem;
  }

  .layer-tag {
    font-size: 1rem;
    opacity: 0.8;
  }

  /* Post Item Hidden State */
  .post-item.hidden {
    display: none;
  }

  @media (max-width: 768px) {
    .filter-buttons {
      gap: 0.5rem;
    }

    .filter-btn {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  // Layer filter functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const postItems = document.querySelectorAll('.post-item');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const selectedLayer = button.getAttribute('data-layer');

      // Update active button
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      // Filter posts
      postItems.forEach(item => {
        const itemLayers = item.getAttribute('data-layers');

        if (selectedLayer === 'all') {
          item.classList.remove('hidden');
        } else {
          if (itemLayers && itemLayers.includes(selectedLayer)) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        }
      });
    });
  });
</script>
