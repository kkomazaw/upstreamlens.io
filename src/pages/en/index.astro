---
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

// Get latest posts and stories
const allPosts = await getCollection('posts', ({ data }) => data.draft !== true);
const allStories = await getCollection('stories', ({ data }) => data.draft !== true);

const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const latestStories = allStories
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="Upstream Lens - Seeing decisions before code is written">
  <div class="hero">
    <div class="hero-background"></div>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="title-main">Upstream Lens</span>
        <span class="title-accent">.</span>
      </h1>
      <p class="hero-tagline">{t('hero.tagline')}</p>
      <div class="hero-cta">
        <a href="/en/philosophy" class="cta-primary">{t('hero.cta.philosophy')}</a>
        <a href="/en/posts" class="cta-secondary">{t('hero.cta.posts')}</a>
        <a href="/en/stories" class="cta-secondary">Stories</a>
      </div>
    </div>
  </div>

  <section class="framework-section">
    <div class="section-header">
      <h2>{t('framework.title')}</h2>
      <p class="section-subtitle">
        {t('framework.subtitle')}
      </p>
    </div>

    <div class="framework-grid">
      <div class="framework-card product">
        <div class="card-header">
          <div class="card-number">01</div>
          <h3>{t('framework.product.title')}</h3>
        </div>
        <div class="card-body">
          <p>{t('framework.product.desc')}</p>
          <div class="card-tag">{t('framework.product.tag')}</div>
        </div>
      </div>

      <div class="framework-card engineering">
        <div class="card-header">
          <div class="card-number">02</div>
          <h3>{t('framework.engineering.title')}</h3>
        </div>
        <div class="card-body">
          <p>{t('framework.engineering.desc')}</p>
          <div class="card-tag">{t('framework.engineering.tag')}</div>
        </div>
      </div>

      <div class="framework-card organization">
        <div class="card-header">
          <div class="card-number">03</div>
          <h3>{t('framework.organization.title')}</h3>
        </div>
        <div class="card-body">
          <p>{t('framework.organization.desc')}</p>
          <div class="card-tag">{t('framework.organization.tag')}</div>
        </div>
      </div>
    </div>

    <div class="framework-footer">
      <a href="/en/philosophy" class="link-arrow">
        {t('framework.learnMore')}
        <span class="arrow">→</span>
      </a>
    </div>
  </section>

  {(latestPosts.length > 0 || latestStories.length > 0) && (
    <section class="latest-content">
      <h2>Latest Content</h2>

      {latestPosts.length > 0 && (
        <div class="content-section">
          <h3>
            <a href="/en/posts" class="section-title">Posts</a>
          </h3>
          <ul class="content-list">
            {latestPosts.map(post => (
              <li>
                <a href={`/en/posts/${post.slug}`} class="content-item">
                  <span class="item-title">{post.data.title}</span>
                  <span class="item-date">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'numeric',
                      day: 'numeric'
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/en/posts" class="view-all">View all Posts →</a>
        </div>
      )}

      {latestStories.length > 0 && (
        <div class="content-section">
          <h3>
            <a href="/en/stories" class="section-title">Stories</a>
          </h3>
          <ul class="content-list">
            {latestStories.map(story => (
              <li>
                <a href={`/en/stories/${story.slug}`} class="content-item">
                  <span class="item-title">{story.data.title}</span>
                  <span class="item-date">
                    {story.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'numeric',
                      day: 'numeric'
                    })}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <a href="/en/stories" class="view-all">View all Stories →</a>
        </div>
      )}
    </section>
  )}

  <section class="status-banner">
    <div class="status-content">
      <div class="status-icon">🚧</div>
      <div class="status-text">
        <strong>{t('status.title')}</strong>
        <p>{t('status.desc')}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    text-align: center;
    padding: 5rem 0 4rem;
    margin: -3rem -1.5rem 4rem;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    opacity: 0.05;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .title-accent {
    color: #f093fb;
    -webkit-text-fill-color: #f093fb;
  }

  .hero-tagline {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-style: italic;
    color: var(--text-secondary);
    margin: 0 0 2rem 0;
    font-weight: 500;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-secondary {
    padding: 0.875rem 2rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1rem;
  }

  .cta-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
  }

  .cta-secondary {
    background: transparent;
    color: var(--accent-color);
    border: 2px solid var(--accent-color);
  }

  .cta-secondary:hover {
    background: var(--accent-color);
    color: white;
    transform: translateY(-2px);
  }

  /* Framework Section */
  .framework-section {
    margin: 5rem 0;
    padding: 3rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    margin: 0 0 1rem 0;
    border-bottom: none;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin: 0;
  }

  .framework-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin: 3rem 0;
  }

  .framework-card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    border: 2px solid var(--border-color);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
  }

  .framework-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--card-gradient));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .framework-card.product::before {
    --card-gradient: #667eea, #764ba2;
  }

  .framework-card.engineering::before {
    --card-gradient: #f093fb, #f5576c;
  }

  .framework-card.organization::before {
    --card-gradient: #4facfe, #00f2fe;
  }

  .framework-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    border-color: transparent;
  }

  .framework-card:hover::before {
    opacity: 1;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .card-number {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-color);
    opacity: 0.5;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .card-body p {
    margin: 0 0 1rem 0;
    line-height: 1.7;
    color: var(--text-color);
  }

  .card-tag {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    background: var(--code-bg);
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-color);
  }

  .framework-footer {
    text-align: center;
    margin-top: 2.5rem;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    transition: gap 0.3s ease;
  }

  .link-arrow:hover {
    gap: 1rem;
  }

  .arrow {
    transition: transform 0.3s ease;
  }

  .link-arrow:hover .arrow {
    transform: translateX(4px);
  }

  /* Latest Content */
  .latest-content {
    margin: 5rem 0;
  }

  .latest-content > h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 3rem;
    border-bottom: none;
  }

  .content-section {
    margin: 3rem 0;
  }

  .content-section h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.5rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .section-title {
    color: var(--heading-color);
    text-decoration: none;
  }

  .section-title:hover {
    color: var(--accent-color);
  }

  .content-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }

  .content-list li {
    border-bottom: 1px solid var(--border-color);
  }

  .content-list li:last-child {
    border-bottom: none;
  }

  .content-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1rem 0;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.2s ease;
  }

  .content-item:hover {
    color: var(--accent-color);
    padding-left: 0.5rem;
  }

  .item-title {
    flex: 1;
    font-weight: 500;
  }

  .item-date {
    font-size: 0.875rem;
    color: var(--text-secondary);
    white-space: nowrap;
    margin-left: 1rem;
  }

  .view-all {
    display: inline-block;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: gap 0.3s ease;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  /* Status Banner */
  .status-banner {
    margin: 4rem 0 2rem;
    padding: 2rem;
    background: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(253, 203, 110, 0.3);
  }

  .status-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .status-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .status-text strong {
    display: block;
    font-size: 1.125rem;
    color: #2d3436;
    margin-bottom: 0.25rem;
  }

  .status-text p {
    margin: 0;
    color: #636e72;
    font-size: 0.95rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: 3rem 0 2rem;
      margin: -3rem -1rem 3rem;
    }

    .framework-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .latest-content {
      margin: 3rem 0;
    }

    .latest-content > h2 {
      font-size: 1.75rem;
      margin-bottom: 2rem;
    }

    .content-section {
      margin: 2rem 0;
    }

    .content-section h3 {
      font-size: 1.25rem;
    }

    .content-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 0.875rem 0;
    }

    .item-date {
      margin-left: 0;
      font-size: 0.8125rem;
    }

    .status-content {
      flex-direction: column;
      text-align: center;
    }

    .section-header h2 {
      font-size: 2rem;
    }
  }
</style>
